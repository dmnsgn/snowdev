{
  "name": "snowdev",
  "version": "3.0.0-alpha.6",
  "description": "Zero configuration, unbundled, opinionated, development and prototyping server for simple ES modules development: types generation, format and linting, dev server and TypeScript support.",
  "keywords": [
    "esm",
    "es-modules",
    "zero-configuration",
    "unbundled",
    "dev",
    "development",
    "prototyping",
    "scaffold",
    "template",
    "boilerplate",
    "server",
    "dev-server",
    "live-reload",
    "hmr",
    "typescript",
    "js-doc",
    "types",
    "prettier",
    "format",
    "formatter",
    "eslint",
    "lint",
    "linter"
  ],
  "homepage": "https://github.com/dmnsgn/snowdev",
  "bugs": "https://github.com/dmnsgn/snowdev/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmnsgn/snowdev.git"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://paypal.me/dmnsgn"
    },
    {
      "type": "individual",
      "url": "https://commerce.coinbase.com/checkout/56cbdf28-e323-48d8-9c98-7019e72c97f3"
    }
  ],
  "license": "MIT",
  "author": "Damien Seguin (https://github.com/dmnsgn)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./eslint.config.js": {
      "types": "./types/eslint.config.d.ts",
      "default": "./eslint.config.js"
    },
    "./prettier.config.js": {
      "types": "./types/prettier.config.d.ts",
      "default": "./prettier.config.js"
    },
    "./jsdoc.json": "./jsdoc.json"
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "snowdev": "cli.js"
  },
  "files": [
    "*.js",
    "jsdoc.json",
    "plugins/**/*",
    "server/**/*",
    "types/**/*",
    "template/**/*",
    "!.DS_Store"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "overrides": {
    "@rollup/plugin-babel": {
      "@babel/core": "$@babel/core"
    }
  },
  "dependencies": {
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/runtime-corejs3": "^8.1.0",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-swc": "0.3.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-wasm": "^6.2.2",
    "@rollup/pluginutils": "^5.5.1",
    "@swc/core": "^1.16.22",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "browserslist-to-esbuild": "^2.1.1",
    "camelcase": "^10.0.0",
    "cheerio": "^1.2.0",
    "chokidar": "^6.0.0",
    "commit-and-tag-version": "^13.3.0",
    "concat-md": "^0.5.1",
    "console-ansi": "^3.0.1",
    "conventional-changelog-angular": "^9.4.0",
    "core-js": "^3.51.0",
    "cosmiconfig": "^10.0.1",
    "deepmerge": "^4.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-node-test": "^1.0.1",
    "eslint-package-json": "^3.0.0",
    "eslint-plugin-css-property-order": "^1.0.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "get-port": "^7.2.0",
    "globals": "^17.14.0",
    "jsdoc-api": "^9.3.6",
    "jsdoc-export-default-interop": "^0.3.1",
    "jsdoc-plugin-intersection": "^1.0.4",
    "jsdoc-plugin-tuple": "^1.0.0",
    "jsdoc-to-markdown": "^9.1.3",
    "jsdoc-tsimport-plugin": "^1.0.5",
    "magic-string": "^1.4.5",
    "npm": "^12.0.2",
    "npm-user": "^6.1.1",
    "open": "^11.0.4",
    "p-debounce": "^6.0.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "replace-in-file": "^9.0.0",
    "resolve": "^2.0.0-next.5",
    "resolve.exports": "^2.0.4",
    "rolldown": "^1.3.1",
    "rollup": "^4.68.2",
    "rollup-plugin-commonjs-named-exports": "^3.0.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-no-op": "^1.1.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-strip-shebang": "^2.0.0",
    "selfsigned": "^5.5.0",
    "semver": "^7.8.6",
    "sirv": "^3.0.2",
    "slash": "^5.1.0",
    "sort-package-json": "^4.1.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "value-format-table": "^1.0.0",
    "ws": "^8.22.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26.0.0",
    "snowdev": ">=3.0.0-alpha.5"
  },
  "snowdev": {
    "serve": false,
    "dependencies": [],
    "files": "{*.js,plugins/**/*.js,server/**/*.js}"
  }
}
